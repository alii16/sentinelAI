# ============================================================
# Sentinel AI - Environment Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# App
APP_NAME=Sentinel AI
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database MySQL 8
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sentinel_ai
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# JWT Secret (ganti dengan string acak yang panjang)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (pisahkan dengan koma)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080"]

# Scanner Settings
PLAYWRIGHT_TIMEOUT=10000
MAX_WORKERS=5
MAX_DEPTH=5
MAX_PAGES=1000
SCAN_DELAY_MS=100
RATE_LIMIT_RPS=5

# File Paths
REPORT_PATH=reports/
DATASET_PATH=datasets/
MODEL_PATH=models/saved/
SCREENSHOT_PATH=storage/screenshots/
UPLOAD_PATH=storage/uploads/

# Anthropic Claude API (untuk AI Chat)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL=claude-sonnet-4-6
