# ============================================================
# Sentinel AI - Environment Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# App
APP_NAME=Sentinel AI
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database MySQL 8
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sentinel_ai
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# JWT Secret (ganti dengan string acak yang panjang)
JWT_SECRET=SENTINEL_AI_CORE_AUTH_SECRET_INTAN_MELDA_PROJ_93
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (pisahkan dengan koma)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080"]

# Scanner Settings
PLAYWRIGHT_TIMEOUT=10000
MAX_WORKERS=5
MAX_DEPTH=5
MAX_PAGES=1000
SCAN_DELAY_MS=100
RATE_LIMIT_RPS=5

# File Paths
REPORT_PATH=reports/
DATASET_PATH=datasets/
MODEL_PATH=app/ml/models/saved/
SCREENSHOT_PATH=storage/screenshots/
UPLOAD_PATH=storage/uploads/

# Chatbot provider configuration
AI_PROVIDER=groq
GROQ_API_KEY=your_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Anthropic / Google API keys remain optional until they are used
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
GOOGLE_API_KEY=
GOOGLE_MODEL=text-bison-001
